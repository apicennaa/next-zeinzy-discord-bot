# ZEINZY Bot — Environment Variables
# Salin file ini menjadi .env dan isi dengan nilai asli.
# JANGAN commit file .env ke repository.

# Discord Bot Token (dari Discord Developer Portal > Bot > Token)
DISCORD_TOKEN=

# Application / Client ID (dari Discord Developer Portal > General Information)
CLIENT_ID=

# Guild ID server Discord tempat bot digunakan
# (klik kanan nama server di Discord > Copy Server ID, perlu Developer Mode aktif)
GUILD_ID=

# Channel ID untuk ledger expense permanen (#expenses atau nama channel lain)
# (klik kanan nama channel di Discord > Copy Channel ID, perlu Developer Mode aktif)
EXPENSE_CHANNEL_ID=
